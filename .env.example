# Copy to .env (next to manage.py) and adjust. Never commit the real .env file.
# Every value below is read by python-decouple; real environment variables take precedence.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Development defaults. In production set DEBUG=False and list your real host names.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Production over HTTPS only (ignored when DEBUG=True):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Optional: where the SQLite database lives (default: db.sqlite3 next to manage.py).
# SQLITE_PATH=

# Optional: fixed password for the accounts created by `manage.py seed_demo_data`.
# When unset, fresh random passwords are generated and printed on every run.
# DEMO_PASSWORD=

# Display currency for prices, and the stock level the staff dashboard flags as low.
CURRENCY_SYMBOL=€
LOW_STOCK_THRESHOLD=2
